<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext needed for LAN Nest (Path B) during owner tests. Prefer HTTPS in production. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
