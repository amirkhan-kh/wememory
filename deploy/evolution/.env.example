# Copy to .env (never commit .env). Ban risk: use a dedicated WhatsApp test number.

SERVER_URL=http://localhost:8080
SERVER_PORT=8080
AUTHENTICATION_API_KEY=change-me-to-long-random-hex

DATABASE_ENABLED=true
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:CHANGE_PG_PASSWORD@evolution-postgres:5432/evolution
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

EVOLUTION_PG_USER=evolution
EVOLUTION_PG_PASSWORD=CHANGE_PG_PASSWORD
EVOLUTION_PG_DB=evolution
EVOLUTION_PORT=8080

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379
CACHE_REDIS_PREFIX_KEY=evolution

CONFIG_SESSION_PHONE_CLIENT=Chrome
CONFIG_SESSION_PHONE_NAME=Chrome
CONFIG_SESSION_PHONE_VERSION=2.3000.1023204200

WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_URL=http://host.docker.internal:3100/api/evolution/webhook
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_MESSAGES_DELETE=true
WEBHOOK_EVENTS_CONTACTS_UPSERT=true
WEBHOOK_EVENTS_CHATS_UPSERT=true

QRCODE_LIMIT=30
QRCODE_COLOR=#00A884
