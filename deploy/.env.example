# Copy to deploy/.env on the server and fill in values.

# Caddy site address: a domain (HTTPS, auto cert) or ":80" when the host only has an IP.
SITE_ADDRESS=memory.yourdomain.com

# Host ports for the Caddy container. Change them when 80/443 are taken by another stack.
HTTP_PORT=80
HTTPS_PORT=443

# Strong random secrets
JWT_SECRET=change-me-to-a-long-random-string
POSTGRES_USER=wamemory
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=wamemory

# Evolution bridge (Path B — ban risk). Nest proxies; Flutter never holds this key.
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=change-me-to-long-random-hex
EVOLUTION_INSTANCE=wamemory
