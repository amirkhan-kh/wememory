{$SITE_ADDRESS} {
	encode gzip

	# NestJS API
	handle /api* {
		reverse_proxy api:3000
	}

	# Test landing + APK downloads
	handle {
		root * /srv/web
		file_server
		try_files {path} /index.html
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Allow APK download
		+Content-Disposition
	}
}
