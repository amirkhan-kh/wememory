{$SITE_ADDRESS} {
	# Gzip only for HTML/CSS/JS — never APK (corrupt install / parse failed).
	@compressible {
		not path /download/* *.apk
	}
	encode @compressible gzip

	# NestJS API
	handle /api* {
		reverse_proxy api:3000
	}

	# APK downloads — raw bytes, no SPA fallback to index.html
	handle /download/* {
		root * /srv/web
		file_server
		header Content-Type "application/vnd.android.package-archive"
		header Content-Disposition "attachment; filename=\"wamemory-test.apk\""
		header Cache-Control "no-store"
	}

	# Test landing
	handle {
		root * /srv/web
		file_server
		try_files {path} /index.html
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
